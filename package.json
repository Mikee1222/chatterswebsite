{
  "name": "chatter-dashboard",
  "version": "1.0.0",
  "description": "Internal dashboard – Airtable backend, Cloudflare deploy",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --project tsconfig.strict.json --noEmit",
    "typecheck:count": "npm run typecheck:strict 2>&1 | grep -c 'error TS' || echo '0 errors'",
    "prepare": "husky",
    "setup:airtable": "tsx scripts/setup-airtable.ts",
    "verify:airtable": "tsx scripts/setup-airtable.ts --verify-only",
    "fetch:schema": "tsx scripts/fetch-airtable-schema.ts",
    "audit:airtable": "tsx scripts/audit-airtable-schema.ts",
    "find:unused": "tsx scripts/find-unused-pages.ts",
    "clean:unused": "tsx scripts/find-unused-pages.ts --delete",
    "setup:model-tables": "tsx scripts/setup-model-tables.ts",
    "complete:model-fields": "tsx scripts/complete-model-fields.ts",
    "complete:period-fields": "tsx scripts/complete-period-fields.ts",
    "add:language-field": "tsx scripts/add-language-field.ts",
    "add:last-login-user-agent-field": "tsx scripts/add-last-login-user-agent-field.ts",
    "add:secondary-role-field": "tsx scripts/add-secondary-role-field.ts",
    "add:va-type-field": "tsx scripts/add-va-type-field.ts",
    "add:social-account-status-fields": "tsx scripts/add-social-account-status-fields.ts",
    "add:model-availability-windows-field": "tsx scripts/add-model-availability-windows-field.ts",
    "create:model-groups-table": "tsx scripts/create-model-groups-table.ts",
    "add:custom-requests-audit-fields": "tsx scripts/add-custom-requests-audit-fields.ts",
    "setup:link-pages-tables": "tsx scripts/setup-link-pages-tables.ts",
    "setup:link-redirects-table": "tsx scripts/setup-link-redirects-table.ts",
    "add:link-pages-fields": "tsx scripts/add-link-pages-fields.ts",
    "add:link-page-fonts": "tsx scripts/add-link-page-fonts.ts",
    "add:link-page-backgrounds": "tsx scripts/add-link-page-backgrounds.ts",
    "setup:link-ab-testing": "tsx scripts/setup-link-ab-testing.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 execute chatter-d1 --remote --file=./drizzle/migrations/0000_initial.sql",
    "db:studio": "drizzle-kit studio",
    "build:next-for-opennext": "NEXT_PRIVATE_STANDALONE=true NEXT_PRIVATE_OUTPUT_TRACE_ROOT=\"$PWD\" npm run build",
    "build:opennext-bundle": "opennextjs-cloudflare build --skipNextBuild --dangerouslyUseUnsupportedNextVersion",
    "pages:build": "npm run build:next-for-opennext && npm run build:opennext-bundle",
    "preview:cf": "npm run pages:build && opennextjs-cloudflare preview",
    "build:cf-wrapper": "npm run pages:build",
    "deploy:cf-wrapper": "cd cloudflare-wrapper && npx wrangler deploy",
    "deploy:cf": "npm run build:cf-wrapper && npm run deploy:cf-wrapper",
    "cron:deploy": "wrangler deploy --config workers/cron-late-shifts/wrangler.jsonc",
    "icon:apple": "node scripts/export-apple-touch-icon.mjs",
    "deploy": "npm run pages:build && opennextjs-cloudflare deploy",
    "preview": "npm run pages:build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@vercel/blob": "^2.5.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "framer-motion": "^11.18.2",
    "jose": "^6.2.0",
    "lucide-react": "^0.294.0",
    "next": "^14.2.35",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.4",
    "swr": "^2.4.1",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "drizzle-kit": "^0.20.0",
    "eslint-config-next": "14.2.21",
    "husky": "^9.1.7",
    "postcss": "^8.4.32",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "wrangler": "^4.87.0"
  }
}
