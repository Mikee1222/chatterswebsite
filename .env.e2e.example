# E2E credentials for Playwright (Supabase preview / local)
# Copy to `.env.e2e` and fill real values. NEVER commit `.env.e2e`.

# Preview (branch supabase-preview-test) — default if unset:
# E2E_BASE_URL=https://chatterswebsite-git-supabase-preview-test-mikee1222s-projects.vercel.app
E2E_BASE_URL=
PLAYWRIGHT_BASE_URL=

# Required when Vercel Deployment Protection (SSO) is on for Preview:
# Create under Project → Settings → Deployment Protection → Protection Bypass for Automation
VERCEL_AUTOMATION_BYPASS_SECRET=

# Role accounts (Supabase users with can_login=true + password_hash).
# Dedicated E2E users recommended (e.g. e2e-admin@gunzo.e2e) so production staff passwords are unused.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

E2E_CHATTER_EMAIL=
E2E_CHATTER_PASSWORD=

E2E_VA_EMAIL=
E2E_VA_PASSWORD=

E2E_MODEL_EMAIL=
E2E_MODEL_PASSWORD=

# Optional custom roles — add E2E_<SLUG>_EMAIL / E2E_<SLUG>_PASSWORD and extend e2e/helpers/credentials.ts
