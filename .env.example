# =============================================================================
# Chatter Dashboard – Production environment variables
# Copy to .env and set real values. Never commit .env or real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Airtable (required until Supabase cutover complete)
# -----------------------------------------------------------------------------
AIRTABLE_TOKEN=YOUR_AIRTABLE_API_KEY
AIRTABLE_BASE_ID=YOUR_AIRTABLE_BASE_ID

# -----------------------------------------------------------------------------
# Supabase / Postgres (Phase 1+ — required after database migration)
# Create a dedicated Supabase project for Gunzo OS; set values in Vercel.
# Never commit real keys. Service role key is server-only.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://wagfkuxkrgsencartqtx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Dual-run data backend (Phase 3). Default airtable — do NOT set supabase in Vercel
# production until cutover. Preview/staging only for verifying migrated slices.
# DATA_BACKEND=airtable
# DATA_BACKEND=supabase
#
# Client Realtime detection: prefer server-injected DataBackendProvider (layouts pass
# getDataBackend()). Optional public mirror — leave unset on Production:
# NEXT_PUBLIC_DATA_BACKEND=supabase
#
# Optional: Project Settings → API → JWT Secret. Enables postgres_changes in addition
# to public broadcast invalidate events. Broadcast works without this.
# SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET


# -----------------------------------------------------------------------------
# Video transcription (optional — Transcript Videos tool + winner video pipeline)
# External HTTP service (e.g. HuggingFace Whisper deployment) exposing POST /transcribe
# -----------------------------------------------------------------------------
# TRANSCRIBE_SERVICE_URL=https://your-transcribe-service.example.com
# TRANSCRIBE_SERVICE_API_KEY=your_transcribe_api_key

# -----------------------------------------------------------------------------
# TheOnlyAPI (optional — OF subscriber fetches when set)
# -----------------------------------------------------------------------------
THE_ONLY_API_KEY=your_key_here

# Optional: verify POST /api/webhooks/onlyapi via x-webhook-secret or x-signature header
ONLYAPI_WEBHOOK_SECRET=your_webhook_shared_secret

# -----------------------------------------------------------------------------
# Infloww Open API (employee sales/chat performance sync)
# Authorization header = raw API key (no "Bearer "). x-oid = agency OID.
# Set both in Vercel env for cron + Sync now. Never commit real keys.
# -----------------------------------------------------------------------------
# INFLOWW_API_KEY=
# INFLOWW_AGENCY_OID=
# Optional: INFLOWW_AUTH_SCHEME=raw|bearer (default raw)
# Optional: INFLOWW_MIN_REQUEST_INTERVAL_MS=200
# Optional: INFLOWW_DEBUG=1

# -----------------------------------------------------------------------------
# Cron auth (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
# -----------------------------------------------------------------------------
# CRON_SECRET=
# -----------------------------------------------------------------------------
# Session / Auth (required in production)
# -----------------------------------------------------------------------------
# Min 32 characters for HS256. Generate: openssl rand -base64 32
SESSION_JWT_SECRET=YOUR_SESSION_SECRET_MIN_32_CHARS

# -----------------------------------------------------------------------------
# Demo login (optional – fallback when no Airtable user matches)
# -----------------------------------------------------------------------------
DEMO_LOGIN_EMAIL=admin@example.com
DEMO_LOGIN_PASSWORD=demo123
DEMO_LOGIN_ROLE=admin

# -----------------------------------------------------------------------------
# App URL (optional but recommended for production – PWA manifest, push, links)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://gunzoteam.com

# -----------------------------------------------------------------------------
# Web Push / VAPID (optional – for push notifications)
# Generate: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY

# -----------------------------------------------------------------------------
# Admin notifications (optional – comma-separated Airtable user record IDs)
# Used to notify admins for whale/custom events.
# -----------------------------------------------------------------------------
# ADMIN_AIRTABLE_USER_IDS=recXXX,recYYY

# -----------------------------------------------------------------------------
# Vercel Blob (optional – feedback screenshot uploads in production)
# Vercel → Project → Storage → Create Blob Store, then copy the read-write token.
# -----------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# Vercel custom domains for link pages (optional – automatic domain connect in admin)
# Vercel → Project Settings → General → Project ID; Account/Team → Tokens for API token.
# -----------------------------------------------------------------------------
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# -----------------------------------------------------------------------------
# Realtime (optional – WebSocket + Durable Object)
# Deploy realtime Worker separately; then set:
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_REALTIME_WS_URL=wss://chatter-realtime.<subdomain>.workers.dev/realtime
# REALTIME_BROADCAST_URL=https://chatter-realtime.<subdomain>.workers.dev
# REALTIME_BROADCAST_SECRET=YOUR_REALTIME_SECRET
# REALTIME_JWT_SECRET=YOUR_REALTIME_JWT_SECRET_MIN_32_CHARS

# -----------------------------------------------------------------------------
# Cloudflare D1 (optional – production auth backend)
# When using D1, bind in wrangler.toml and set:
# -----------------------------------------------------------------------------
# D1_DATABASE_ID=your_d1_database_id

# -----------------------------------------------------------------------------
# Internal: notification test + diagnostic UI / API (optional – do not enable unless intended)
# When NODE_ENV=production, set to "true" to allow /admin/test-notifications,
# /admin/notification-diagnostic, and matching /api/debug/* routes (admin session still required).
# -----------------------------------------------------------------------------
# ENABLE_NOTIFICATION_TESTING=true
