{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatterswebsite",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-05",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {

  },
  "routes": [
    {
      "pattern": "gunzoteam.com/*",
      "zone_name": "gunzoteam.com"
    }
  ],
  "migrations": [
    {
      "tag": "migrate-realtimehub-local-seed",
      "new_classes": ["RealtimeHub"]
    },
    {
      "tag": "v1",
      "deleted_classes": ["RealtimeHub"]
    }
  ]
}
